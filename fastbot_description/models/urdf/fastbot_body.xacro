<?xml version="1.0" ?>
<robot name="fastbot_body" xmlns:xacro="http://ros.org/wiki/xacro">
  
  <xacro:macro name="fastbot_body" params="robot_name">
    
    <link name="${robot_name}_base_link">
		<inertial>
			<origin rpy="0 0 0" xyz="-0.002760040106013823 -0.001188341092731165 0.0718803300182357"/>
			<mass value="0.5998126574179536"/>
			<inertia ixx="0.001977" ixy="-1.9e-05" ixz="1.6e-05" iyy="0.001845" iyz="3.1e-05" izz="0.001587"/>
		</inertial>
		<visual>
			<origin rpy="0 0 0" xyz="0 0 0"/>
			<geometry>
				<mesh filename="$(find fastbot_description)/models/meshes/base_link.stl" scale="0.001 0.001 0.001"/>
			</geometry>
			<material name="grey"/>
		</visual>
		<collision>
			<origin rpy="0 0 0" xyz="0 0 0"/>
			<geometry>
				<mesh filename="$(find fastbot_description)/models/meshes/base_link.stl" scale="0.001 0.001 0.001"/>
			</geometry>
		</collision>
	</link>

	<link name="${robot_name}_wheel_right">
		<inertial>
			<origin rpy="0 0 0" xyz="-1.3588436534317516e-07 -0.01588997385974819 2.4327475205837557e-07"/>
			<mass value="0.23341302374485867"/>
			<inertia ixx="9.6e-05" ixy="-0.0" ixz="0.0" iyy="0.00016" iyz="0.0" izz="9.6e-05"/>
		</inertial>
		<visual>
			<origin rpy="0 0 0" xyz="-0.0325 0.07073 -0.03245"/>
			<geometry>
                <mesh filename="$(find fastbot_description)/models/meshes/wheel_right.stl" scale="0.001 0.001 0.001"/>
			</geometry>
			<material name="black"/>
		</visual>
		<collision>
			<origin rpy="0 0 0" xyz="-0.0325 0.07073 -0.03245"/>
			<geometry>
                <mesh filename="$(find fastbot_description)/models/meshes/wheel_right.stl" scale="0.001 0.001 0.001"/>
			</geometry>
		</collision>
	</link>

	<link name="${robot_name}_wheel_left">
		<inertial>
			<origin rpy="0 0 0" xyz="-1.3200802984753013e-07 0.015889975585968247 2.563618809944823e-07"/>
			<mass value="0.2334125809795772"/>
			<inertia ixx="9.6e-05" ixy="0.0" ixz="0.0" iyy="0.00016" iyz="-0.0" izz="9.6e-05"/>
		</inertial>
		<visual>
			<origin rpy="0 0 0" xyz="-0.0325 -0.07073 -0.03245"/>
			<geometry>
                <mesh filename="$(find fastbot_description)/models/meshes/wheel_left.stl" scale="0.001 0.001 0.001"/>
			</geometry>
			<material name="black"/>
		</visual>
		<collision>
			<origin rpy="0 0 0" xyz="-0.0325 -0.07073 -0.03245"/>
			<geometry>
                <mesh filename="$(find fastbot_description)/models/meshes/wheel_left.stl" scale="0.001 0.001 0.001"/>
			</geometry>
		</collision>
	</link>

	<link name="${robot_name}_caster">
		<inertial>
			<origin rpy="0 0 0" xyz="-0.01100000059604822 -1.4270326137978878e-17 -0.006845279720279717"/>
			<mass value="0.02931481955170001"/>
			<inertia ixx="2e-06" ixy="-0.0" ixz="0.0" iyy="2e-06" iyz="-0.0" izz="1e-06"/>
		</inertial>
		<visual>
			<origin rpy="0 0 0" xyz="0.032 -0.0 -0.01915"/>
			<geometry>
				<mesh filename="$(find fastbot_description)/models/meshes/caster.stl" scale="0.001 0.001 0.001"/>
			</geometry>
			<material name="black"/>
		</visual>
		<collision>
			<origin rpy="0 0 0" xyz="0.032 -0.0 -0.01915"/>
			<geometry>
				<mesh filename="$(find fastbot_description)/models/meshes/caster.stl" scale="0.001 0.001 0.001"/>
			</geometry>
		</collision>
	</link>

	<link name="${robot_name}_lidar_body">
		<inertial>
			<origin rpy="0 0 0" xyz="0.04189252309401799 -0.030999999999999896 0.02544713291508699"/>
			<mass value="0.07136843474102665"/>
			<inertia ixx="2.3e-05" ixy="0.0" ixz="5e-06" iyy="6.1e-05" iyz="0.0" izz="7.7e-05"/>
		</inertial>
		<visual>
			<origin rpy="0 0 0" xyz="0.022 -0.031 -0.14715"/>
			<geometry>
				<mesh filename="$(find fastbot_description)/models/meshes/lidar_body.stl" scale="0.001 0.001 0.001"/>
			</geometry>
			<material name="black"/>
		</visual>
		<collision>
			<origin rpy="0 0 0" xyz="0.022 -0.031 -0.14715"/>
			<geometry>
				<mesh filename="$(find fastbot_description)/models/meshes/lidar_body.stl" scale="0.001 0.001 0.001"/>
			</geometry>
		</collision>
	</link>

	<link name="${robot_name}_lidar_motorend">
		<inertial>
			<origin rpy="0 0 0" xyz="-1.3877787807814457e-17 7.710435591426653e-18 0.002750000000000058"/>
			<mass value="0.0005131791599638964"/>
			<inertia ixx="0.0" ixy="-0.0" ixz="0.0" iyy="0.0" iyz="0.0" izz="0.0"/>
		</inertial>
		<visual>
			<origin rpy="0 0 0" xyz="-0.05 -0.0 -0.18065"/>
			<geometry>
                <mesh filename="$(find fastbot_description)/models/meshes/lidar_motorend.stl" scale="0.001 0.001 0.001"/>
			</geometry>
			<material name="blue"/>
		</visual>
		<collision>
			<origin rpy="0 0 0" xyz="-0.05 -0.0 -0.18065"/>
			<geometry>
                <mesh filename="$(find fastbot_description)/models/meshes/lidar_motorend.stl" scale="0.001 0.001 0.001"/>
			</geometry>
		</collision>
	</link>

	<link name="${robot_name}_lidar_bottom">
		<inertial>
			<origin rpy="0 0 0" xyz="-1.0850529511452296e-17 5.425264755726148e-18 0.007750000000000035"/>
			<mass value="0.062236577058626265"/>
			<inertia ixx="1.8e-05" ixy="-0.0" ixz="-0.0" iyy="1.8e-05" iyz="0.0" izz="3.3e-05"/>
		</inertial>
		<visual>
			<origin rpy="0 0 0" xyz="0.0 -0.0 -0.18065"/>
			<geometry>
                <mesh filename="$(find fastbot_description)/models/meshes/lidar_bottom.stl" scale="0.001 0.001 0.001"/>
			</geometry>
			<material name="blue"/>
		</visual>
		<collision>
			<origin rpy="0 0 0" xyz="0.0 -0.0 -0.18065"/>
			<geometry>
				<mesh filename="$(find fastbot_description)/models/meshes/lidar_bottom.stl" scale="0.001 0.001 0.001"/>
			</geometry>
		</collision>
	</link>

	<link name="${robot_name}_lidar_frame">
		<inertial>
			<origin rpy="0 0 0" xyz="-1.2613740557063325e-17 4.204580185687775e-18 0.00500000000000006"/>
			<mass value="0.040152630360403944"/>
			<inertia ixx="1.1e-05" ixy="0.0" ixz="0.0" iyy="1.1e-05" iyz="-0.0" izz="2.2e-05"/>
		</inertial>
		<visual>
			<origin rpy="0 0 0" xyz="0.0 -0.0 -0.19615"/>
			<geometry>
                <mesh filename="$(find fastbot_description)/models/meshes/lidar_top_${robot_name}.dae" scale="0.001 0.001 0.001"/>
     		</geometry>
			<material name="blue"/>
		</visual>
		<collision>
			<origin rpy="0 0 0" xyz="0.0 -0.0 -0.19615"/>
			<geometry>
                <mesh filename="$(find fastbot_description)/models/meshes/lidar_top.stl" scale="0.001 0.001 0.001"/>
			</geometry>
		</collision>
	</link>

	<link name="${robot_name}_lidar">
	</link>

	<link name="${robot_name}_imu">
		<inertial>
			<origin rpy="0 0 0" xyz="-0.005006317892412869 0.010331821776814253 0.0005641458401822869"/>
			<mass value="0.0005786974233911084"/>
			<inertia ixx="0.0" ixy="0.0" ixz="-0.0" iyy="0.0" iyz="-0.0" izz="0.0"/>
		</inertial>
		<visual>
			<origin rpy="0 0 0" xyz="-0.04 0.01025 -0.10543"/>
			<geometry>
                <mesh filename="$(find fastbot_description)/models/meshes/imu.stl" scale="0.001 0.001 0.001"/>
			</geometry>
			<material name="grey"/>
		</visual>
		<collision>
			<origin rpy="0 0 0" xyz="-0.04 0.01025 -0.10543"/>
			<geometry>
                <mesh filename="$(find fastbot_description)/models/meshes/imu.stl" scale="0.001 0.001 0.001"/>
			</geometry>
		</collision>
	</link>

	<link name="${robot_name}_camera">
		<inertial>
			<origin rpy="0 0 0" xyz="-0.000736316919000779 9.521361965188852e-15 0.01215919671545948"/>
			<mass value="0.011070080401829364"/>
			<inertia ixx="1e-06" ixy="-0.0" ixz="0.0" iyy="1e-06" iyz="0.0" izz="1e-06"/>
		</inertial>
		<visual>
			<origin rpy="0 0 0" xyz="-0.061 -0.0 -0.11515"/>
			<geometry>
				<mesh filename="$(find fastbot_description)/models/meshes/camera.stl" scale="0.001 0.001 0.001"/>
			</geometry>
			<material name="grey"/>
		</visual>
		<collision>
			<origin rpy="0 0 0" xyz="-0.061 -0.0 -0.11515"/>
			<geometry>
				<mesh filename="$(find fastbot_description)/models/meshes/camera.stl" scale="0.001 0.001 0.001"/>
			</geometry>
		</collision>
	</link>

	<joint name="${robot_name}_motor_right" type="continuous">
		<origin rpy="0 0 0" xyz="0.0325 -0.07073 0.03245"/>
		<parent link="${robot_name}_base_link"/>
		<child link="${robot_name}_wheel_right"/>
		<axis xyz="0 1 0"/>
	</joint>

	<joint name="${robot_name}_motor_left" type="continuous">
		<origin rpy="0 0 0" xyz="0.0325 0.07073 0.03245"/>
		<parent link="${robot_name}_base_link"/>
		<child link="${robot_name}_wheel_left"/>
		<axis xyz="0 1 0"/>
	</joint>

	<joint name="${robot_name}_Rigid3" type="fixed">
		<origin rpy="0 0 0" xyz="-0.032 0.0 0.01915"/>
		<parent link="${robot_name}_base_link"/>
		<child link="${robot_name}_caster"/>
	</joint>

	<joint name="${robot_name}_Rigid4" type="fixed">
		<origin rpy="0 0 0" xyz="-0.022 0.031 0.14715"/>
		<parent link="${robot_name}_base_link"/>
		<child link="${robot_name}_lidar_body"/>
	</joint>

	<joint name="${robot_name}_Rigid5" type="fixed">
		<origin rpy="0 0 0" xyz="0.072 -0.031 0.0335"/>
		<parent link="${robot_name}_lidar_body"/>
		<child link="${robot_name}_lidar_motorend"/>
	</joint>

	<joint name="${robot_name}_Rigid6" type="fixed">
		<origin rpy="0 0 0" xyz="0.022 -0.031 0.0335"/>
		<parent link="${robot_name}_lidar_body"/>
		<child link="${robot_name}_lidar_bottom"/>
	</joint>

	<joint name="${robot_name}_Rigid7" type="fixed">
		<origin rpy="0 0 0" xyz="0.0 0.0 0.0155"/>
		<parent link="${robot_name}_lidar_bottom"/>
		<child link="${robot_name}_lidar_frame"/>
	</joint>

	<joint name="${robot_name}_lidar_sensor_joint" type="fixed">
		<origin rpy="0 0 3.14159265359" xyz="0.0 0.0 0"/>
		<parent link="${robot_name}_lidar_frame"/>
		<child link="${robot_name}_lidar"/>
	</joint>

	<joint name="${robot_name}_Rigid8" type="fixed">
		<origin rpy="0 0 0" xyz="0.04 -0.01025 0.10543"/>
		<parent link="${robot_name}_base_link"/>
		<child link="${robot_name}_imu"/>
	</joint>

	<joint name="${robot_name}_Rigid9" type="fixed">
		<origin rpy="0 0 0" xyz="0.061 0.0 0.11515"/>
		<parent link="${robot_name}_base_link"/>
		<child link="${robot_name}_camera"/>
	</joint>

	<joint name="${robot_name}_base_to_gripper" type="fixed">
		<origin rpy="0 0 -1.57" xyz="0.07 0.0 0.03"/>
		<parent link="${robot_name}_base_link"/>
		<child link="${robot_name}_support_link"/>
	</joint>

    <!-- Support Link -->
    <link name="${robot_name}_support_link">
		<inertial>
			<mass value="0.03"/>
			<inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>			
		</inertial>
		<visual>
		  <origin xyz="0 0 0" rpy="0 0 0"/>
		  <geometry>
			<box size="0.07 0.01 0.01"/>
		  </geometry>
		</visual>
		<collision>
			<origin xyz="0 0 0" rpy="0 0 0"/>
			<geometry>
			  <box size="0.07 0.01 0.01"/>
			</geometry>  
		</collision>
	</link>
  
	<!-- Gripper Link 1 -->
	<link name="${robot_name}_gripper_link_1">
		<inertial>
			<mass value="0.03"/>
			<inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>			
		</inertial>
		<visual>
		  <origin xyz="0.025 0.05 0" rpy="0 0 1.57"/>
		  <geometry>
			<box size="0.09 0.01 0.01"/>
		  </geometry>
		</visual>
		<!-- <collision>
			<origin xyz="0.025 0.05 0" rpy="0 0 1.57"/>
			<geometry>
			  <box size="0.09 0.01 0.01"/>
			</geometry>			  
		</collision> -->
	</link>
  
	<!-- Gripper Link 2 -->
	<link name="${robot_name}_gripper_link_2">
		<inertial>
			<mass value="0.03"/>
			<inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>			
		</inertial>
		<visual>
		  <origin xyz="-0.025 0.05 0" rpy="0 0 1.57"/>
		  <geometry>
			<box size="0.09 0.01 0.01"/>
		  </geometry>
		</visual>
		<!-- <collision>
			<origin xyz="-0.025 0.05 0" rpy="0 0 1.57"/>
			<geometry>
			  <box size="0.09 0.01 0.01"/>
			</geometry>			  
		</collision> -->
	</link>
  
	<!-- Prismatic Joint -->
	<joint name="${robot_name}_prismatic_joint" type="prismatic">
		<parent link="${robot_name}_support_link"/>
		<child link="${robot_name}_gripper_link_1"/>
		<origin xyz="0 0 0" rpy="0 0 0"/>
		<axis xyz="1 0 0"/>
		<limit lower="-0.04" upper="0.04" effort="1.0" velocity="1.0"/>
		<dynamics damping="0.1"/>
	</joint>
  
	<!-- Prismatic Joint -->
	<joint name="${robot_name}_prismatic_joint_2" type="prismatic">
		<mimic joint="${robot_name}_prismatic_joint" multiplier="-1" offset="0"/>
		<parent link="${robot_name}_support_link"/>
		<child link="${robot_name}_gripper_link_2"/>
		<origin xyz="0 0 0" rpy="0 0 0"/>
		<axis xyz="1 0 0"/>
		<limit lower="-0.04" upper="0.04" effort="1.0" velocity="1.0"/>
		<dynamics damping="0.1"/>
	</joint>

	<ros2_control name="GazeboSystem" type="system">
		<hardware>
		  <plugin>gazebo_ros2_control/GazeboSystem</plugin>
		</hardware>
		<joint name="${robot_name}_prismatic_joint">
			<command_interface name="position">
			<!-- <param name="min">-1</param>
			<param name="max">1</param> -->
		  	</command_interface>
		  	<state_interface name="position">
				<param name="initial_value">0.0</param>
		  	</state_interface>
		  	<state_interface name="velocity"/>
		  	<state_interface name="effort"/>
		</joint>
		<joint name="${robot_name}_prismatic_joint_2" mimic="true">
			<param name="mimic">${robot_name}_prismatic_joint</param>
			<param name="multiplier">-1</param>
			<command_interface name="position"/>
			<state_interface name="position">
				<param name="initial_value">0.0</param>
		  	</state_interface>
			<state_interface name="effort"/>
			<state_interface name="velocity"/>
		</joint>
	</ros2_control> 

	<!-- Gripper ROS 2 control plugin -->
	<!-- <gazebo>
		<plugin name="${robot_name}_gripper_ros2_control" filename="libgazebo_ros2_control.so">
			<ros>
				<namespace>${robot_name}</namespace>
			</ros>
			<robot_param>${robot_name}_robot_description</robot_param>
			<robot_param_node>${robot_name}_robot_state_publisher</robot_param_node>
			<parameters>$(find fastbot_gazebo)/config/gripper_controller_${robot_name}.yaml</parameters>
		</plugin>
	</gazebo> -->



  </xacro:macro>
  
  
  
</robot>
